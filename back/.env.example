# PostgreSQL - foloseste fie DATABASE_URL, fie variabilele individuale

# Varianta 1: connection string complet
DATABASE_URL=postgresql://postgres:parola_ta@localhost:5432/clinica

# Varianta 2: variabile separate (optional daca nu folosesti DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=parola_ta
# PGDATABASE=clinica

# Pentru servicii cloud (Render, Supabase, Railway) seteaza SSL
# PGSSL=true
